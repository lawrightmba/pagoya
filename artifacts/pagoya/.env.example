# PagoYa Frontend — environment variables
# Copy this file to .env.local and fill in the values.

# Conekta public (client-side) key for card tokenization
VITE_CONEKTA_PUBLIC_KEY=

# Stripe publishable key (if using Stripe checkout)
VITE_STRIPE_PUBLIC_KEY=

# ── Backend / API Server ────────────────────────────────────────────────────
# Conekta private key for OXXO cash orders (api.digitalfemsa.io)
CONEKTA_API_KEY=

# Conekta private key for card orders (api.conekta.io, Accept: vnd.conekta-v2.2.0+json)
CONEKTA_CARD_API_KEY=your_conekta_card_private_key_here
