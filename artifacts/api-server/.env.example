# SIPREL / Taecel (bill payments + mobile top-ups)
SIPREL_API_KEY=your_taecel_api_key_here
SIPREL_PIN=your_taecel_pin_here
# SIPREL_BASE_URL=https://app.taecel.com/api/   # optional — default shown

# Stripe
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pagoya

# Conekta / Digitalfemsa (OXXO wallet loads)
# API key for creating OXXO orders — get from Conekta Dashboard → API Keys
CONEKTA_API_KEY=key_...
# RSA public key for webhook signature verification — get from Conekta Dashboard → Developers → Webhooks
# Store as a single line (Replit Secrets collapses newlines; the code re-wraps it automatically)
# Accepted under either name: CONEKTA_WEBHOOK_PUBLIC_KEY takes priority, CONEKTA_PUBLIC_KEY is the fallback
CONEKTA_WEBHOOK_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----
# Note: CONEKTA_WEBHOOK_SECRET is NOT used for webhook verification (verification uses the RSA public key above)

# Conekta (card charges via api.conekta.io)
# Private key for creating card orders — get from panel.conekta.com → API Keys
CONEKTA_CARD_API_KEY=key_...
# Publishable key for Conekta.js tokenization in the browser — panel.conekta.com → API Keys
VITE_CONEKTA_PUBLIC_KEY=key_pub_...
# Shared HMAC secret for card webhook signature verification
# Get from panel.conekta.com → Developers → Webhooks (after registering the endpoint)
# Webhook URL:   https://pagoyamx.com/api/wallet/webhook/conekta-card
# Events:        charge.paid, charge.failed
CONEKTA_CARD_WEBHOOK_SECRET=your_webhook_secret_here

# Belvo Direct Debit
BELVO_DD_KEY_ID=your_direct_debit_key_id_here
BELVO_DD_KEY_SECRET=your_direct_debit_key_secret_here
BELVO_DD_ENV=sandbox

# Admin alerts (WhatsApp via Twilio)
# Recipient number for operational alerts (low SIPREL balance, etc.)
# Format: whatsapp:+521XXXXXXXXXX
ADMIN_WHATSAPP_NUMBER=whatsapp:+521XXXXXXXXXX
