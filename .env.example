# ─── Conekta / DigitalFemsa ───────────────────────────────────────────────────
# OXXO cash orders (api.digitalfemsa.io)
CONEKTA_API_KEY=
# Card charges (api.conekta.io)
CONEKTA_CARD_API_KEY=
CONEKTA_PUBLIC_KEY=
CONEKTA_SECRET_KEY=
# Webhook signature verification
# OXXO webhook: RS256 public key from Conekta dashboard → Developers → Webhooks
CONEKTA_WEBHOOK_PUBLIC_KEY=
# Card webhook: HMAC-SHA256 shared secret from Conekta dashboard
CONEKTA_CARD_WEBHOOK_SECRET=
# Frontend public key (used by Conekta.js tokenization)
VITE_CONEKTA_PUBLIC_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=

# ─── SIPREL ───────────────────────────────────────────────────────────────────
SIPREL_API_KEY=
SIPREL_PIN=

# ─── Twilio / WhatsApp ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender number: e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Admin WhatsApp number for operational alerts
ADMIN_WHATSAPP_NUMBER=

# ─── STP (Sistema de Transferencias y Pagos) ──────────────────────────────────
# Empresa name assigned by STP
STP_EMPRESA=
# Single pooled CLABE that receives all inbound SPEI transfers
STP_CLABE_RECEPTOR=
# Shared secret for HMAC-SHA256 webhook signature validation
STP_WEBHOOK_SECRET=
# Set to "true" to show the SPEI tab in the wallet load screen
STP_ENABLED=false

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=
